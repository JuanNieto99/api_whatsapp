# Copiá este archivo a .env y poné valores propios (NO lo subas al repo).

# Secreto interno que protege el motor WAHA y que nuestra capa usa para hablarle.
WAHA_API_KEY=change-me-please

# Imagen del motor WAHA. En servers ARM (Oracle/Graviton) pinear la variante ARM:
# WAHA_IMAGE=devlikeapro/waha:noweb-arm
# Si se omite se usa devlikeapro/waha (multiarch genérica).
# WAHA_IMAGE=

# --- Siembra de la autenticación (SOLO el primer arranque) -------------------
# La API exige SIEMPRE auth: cookie de admin (POST /login) o header X-Api-Key
# con el token vigente. Credenciales y token se persisten en ./data/auth.json;
# estas variables solo se usan si ese archivo todavía no existe.
#
# Usuario y contraseña del admin (defaults del equipo si se omiten).
# ADMIN_USER=admin
# ADMIN_PASS=cambia-esta-clave
#
# Token inicial de API. IMPORTANTE en migraciones: poné acá la key que los
# consumidores ya mandan (la vieja FACADE_API_KEY) para que sigan funcionando
# sin corte; después se puede rotar desde el panel.
# FACADE_API_KEY=pon-aqui-un-secreto-fuerte
