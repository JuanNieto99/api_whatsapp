# Copiá este archivo a .env y poné valores propios (NO lo subas al repo).

# Secreto interno que protege el motor WAHA y que nuestra capa usa para hablarle.
WAHA_API_KEY=change-me-please

# (Opcional) Auth de la fachada hacia AFUERA. Si se define (no vacío), todas las
# rutas de la API exigen el header X-Api-Key con este valor (la web UI en / sigue
# pública y lo adjunta desde el navegador). Si se deja vacío/comentado, la API
# queda ABIERTA (comportamiento legacy; no rompe consumidores que llaman sin auth).
# Es DISTINTA de WAHA_API_KEY. Recomendado definirla si exponés la API a internet.
# FACADE_API_KEY=pon-aqui-un-secreto-fuerte
